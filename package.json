{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "koishi-plugin-marketn-refactored",
    "version": "0.1.0",
    "description": "Next-generation Koishi plugin market and dependency management center (refactored)",
    "type": "module",
    "main": "./lib/node/index.js",
    "types": "./lib/node/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/node/index.d.ts",
            "development": {
                "node": "./src/node/index.ts"
            },
            "node": "./lib/node/index.js"
        },
        "./shared": {
            "types": "./lib/shared/index.d.ts",
            "development": "./src/shared/index.ts",
            "default": "./lib/shared/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "dist"
    ],
    "homepage": "https://github.com/Oppenheymu/koishi-plugin-marketn-refactored#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Oppenheymu/koishi-plugin-marketn-refactored.git"
    },
    "bugs": {
        "url": "https://github.com/Oppenheymu/koishi-plugin-marketn-refactored/issues"
    },
    "license": "MIT",
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "keywords": [
        "bot",
        "chatbot",
        "koishi",
        "plugin",
        "market",
        "manager",
        "server"
    ],
    "engines": {
        "node": ">=20.19"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "biome check . && yarn ts7 --noEmit && yarn ts7 --noEmit -p client/tsconfig.json && eslint \"client/**/*.vue\" && node scripts/check-size.mjs",
        "check:size": "node scripts/check-size.mjs",
        "build": "tsdown && vite build",
        "build:client": "vite build",
        "test": "vitest run",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "lint:client": "eslint \"client/**/*.vue\"",
        "ts7": "node ../../node_modules/@typescript/native/bin/tsc",
        "ts7:typecheck": "yarn ts7 --noEmit && yarn ts7 --noEmit -p client/tsconfig.json",
        "typecheck:legacy": "tsc6 --noEmit"
    },
    "koishi": {
        "public": [
            "dist"
        ],
        "description": {
            "en": "Next-generation Koishi plugin market and dependency management center (refactored)",
            "zh": "下一代 Koishi 插件市场与依赖管理中心（重构版）"
        },
        "service": {
            "optional": [
                "console"
            ],
            "implements": [
                "installer"
            ]
        }
    },
    "dependencies": {
        "@koishijs/components": "^1.5.22",
        "@koishijs/console": "^5.30.11",
        "@koishijs/registry": "^7.0.3",
        "@noble/hashes": "^2.3.0",
        "cosmokit": "^1.8.1",
        "execa": "^10.0.1",
        "get-registry": "^1.2.0",
        "p-map": "^7.0.6",
        "package-manager-detector": "^1.8.0",
        "semver": "^7.8.5",
        "tar": "^7.5.22",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "@koishijs/plugin-console": "^5.30.11",
        "koishi": "^4.18.11"
    },
    "peerDependenciesMeta": {
        "@koishijs/plugin-console": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@koishijs/client": "^5.30.11",
        "@koishijs/plugin-config": "^2.8.6",
        "@maikolib/vite-plugin-yaml": "^1.1.1-0",
        "@types/node": "^26.1.2",
        "@types/semver": "^7.5.8",
        "@typescript-eslint/parser": "^8.67.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vueuse/core": "^14.4.0",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "sass-embedded": "^1.102.0",
        "tsdown": "^0.22.14",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "unocss": "^66.8.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10",
        "vue": "^3.5.12",
        "vue-eslint-parser": "^10.4.1"
    }
}