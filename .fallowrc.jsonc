{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    // 移植参照与构建产物，不参与分析：
    // - Waiting_refactored/ 原版代码快照（P5 冒烟的移植参照，P6 删除）
    // - 原版参考/ 官方 @koishijs/plugin-market 拷贝（本地对照）
    "ignorePatterns": [
        "Waiting_refactored/**",
        "原版参考/**",
        "lib/**",
        "dist/**",
        "client-tsc-out.txt"
    ],
    // client 控制台入口：c66bbc5 把 vite.config.ts 改为编程式脚本（scripts/build-client.ts）后，
    // fallow 的 vite 插件不再能发现 lib 入口，需在此手动声明，否则整个 client/ 树会被误报为死代码。
    "entry": [
        "client/index.ts"
    ],
    // 这些包由 yarn 脚本或 Koishi Console 宿主提供，不随插件自身运行时安装：
    // @typescript/native 被 yarn ts7 脚本经 node 直调（path 越出项目根，fallow 扫不到入口）；
    // client/vue/vueuse 是 Vite external，运行时由 Console 的前端环境提供。
    "ignoreDependencies": [
        "@typescript/native",
        "@koishijs/client",
        "@vueuse/core",
        "vue"
    ],
    // 已人工复核的结构性重复：版本选择器、两套变量体系的批量行，以及
    // install/uninstall 中语义相反的安装状态守卫，不应强行抽象。
    // 另登记 2026-08-24 复核的 3 组视觉有意重复：
    // 1. extensions/version 与 dependencies 页面的危险按钮样式（各自作用域，
    //    颜色体系完全一致但类名不同，合并会破坏样式隔离）；
    // 2. bundle-install 必装/可选成员的行模板（结构对称、交互分支不同）；
    // 3. bundle-install 与 market/package 的分类色映射（cat-* 两套变量体系）。
    "duplicates": {
        "ignoredClones": [
            "dup:c77b3abb6f87acd9-2:2",
            "dup:f93565d2:2",
            "dup:c77b3abb6f87acd9-1:2",
            "dup:deb1902d:2",
            "dup:c77b3abb6f87acd9-3:2",
            "dup:c19694e6:2"
        ]
    },
    // Koishi Console 通过 DataService 反射调用 get；MarketProvider 还由 idle-probe
    // 通过多态可选接口调用 probeInBackground，静态调用图无法完整穿透这些入口。
    "usedClassMembers": [
        {
            "extends": "DataService",
            "members": [
                "get"
            ]
        },
        {
            "extends": "BaseMarketProvider",
            "members": [
                "get",
                "probeInBackground"
            ]
        }
    ],
    // node 层 provider 有意遮蔽 shared 层同名 provider，作为 Koishi 插件入口注册。
    "ignoreExports": [
        {
            "file": "src/node/market/index.ts",
            "exports": [
                "MarketProvider"
            ]
        },
        {
            "file": "src/shared/provider.ts",
            "exports": [
                "MarketProvider"
            ]
        },
        // 契约面 type re-export：聚合出口按拆分前的导出面原样转发，
        // 供外部消费者按名导入（客户端入口之外无静态消费者，误报 unused-types）。
        {
            "file": "client/shared/plugin-config/index.ts",
            "exports": [
                "MarketNextConfig",
                "MarketNextConfigPatch",
                "MarketNextDataStore",
                "UpdateIgnoreOptions",
                "UpdateIgnoreRule"
            ]
        },
        {
            "file": "client/market/avatar/index.ts",
            "exports": [
                "AvatarCandidate"
            ]
        },
        {
            "file": "client/market/utils.ts",
            "exports": [
                "MarketConfig"
            ]
        },
        {
            "file": "client/pages/dependencies/use-dependency-groups.ts",
            "exports": [
                "DependencyGroup"
            ]
        },
        {
            "file": "client/shared/operations/index.ts",
            "exports": [
                "LogLine"
            ]
        }
    ],
    // 复杂度豁免天花板（health.thresholdOverrides）：2026-08-25 重构计划收尾登记。
    // 三个 .vue 模板的报点锚点在多行标签的属性行中间，代码内 <!-- fallow-ignore --> 注释
    // 无法合法插入标签内部，故按函数名在配置里登记天花板（保持 findings 可见，仅放宽阈值）。
    // 模板复杂度属 dialog/页面多视图展示分支，计划书 §3.2 判定为登记豁免，不拆子组件。
    "health": {
        "thresholdOverrides": [
            {
                "files": ["client/dialogs/bundle-install/index.vue"],
                "functions": ["<template>"],
                "maxCyclomatic": 72,
                "maxCognitive": 210,
                "reason": "合包安装对话框模板:必装/可选成员两段对称展示,分支密度来自成员状态与冲突展示"
            },
            {
                "files": ["client/pages/dependencies/package.vue"],
                "functions": ["<template>"],
                "maxCyclomatic": 32,
                "maxCognitive": 45,
                "reason": "依赖卡片模板:11 态卡片的展示分支,状态密度来自依赖状态机"
            },
            {
                "files": ["client/dialogs/bundle-uninstall/index.vue"],
                "functions": ["<template>"],
                "maxCognitive": 45,
                "reason": "合包卸载对话框模板:按成员分组展示与勾选,分支即成员状态"
            }
        ]
    },
    // 这些成员由安装器状态机或 Koishi 生命周期间接调用，调用点不以同名方法引用出现。
    "overrides": [
        {
            "files": [
                "src/core/deps/resolver.ts",
                "src/core/install/logs/store.ts"
            ],
            "rules": {
                "unused-class-members": "off"
            }
        }
    ]
    // client/ 入口经上方 entry 显式声明（vite.config.ts 移除后 fallow 无法自动发现
    // lib 入口；原「无需 dynamicallyLoaded 豁免」的验证说明已随 c66bbc5 过时）。
    // 用法、基线数据与误报豁免清单见 docs/DEVELOPMENT.md §8。
}
