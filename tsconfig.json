{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2025",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2025"
        ],
        "types": [
            "node"
        ],
        "declaration": true,
        "declarationMap": true
    },
    "include": [
        "src"
    ]
}
